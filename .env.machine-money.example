# =============================================================================
# AuRAG × Machine Money: Bitcoin Lightning Network Configuration Template
# =============================================================================
# Copy this file to .env or .env.local to configure Machine Money settlement rails.
# NEVER commit real credentials, private keys, or API tokens to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Core Machine Money Governance & Feature Flags
# -----------------------------------------------------------------------------
# Enable or disable the autonomous Lightning micro-settlement subsystem
MACHINE_MONEY_ENABLED=true

# Payment provider adapter: 'mock' (zero-cost offline simulation), 'lnbits', or 'cln'
MACHINE_MONEY_PROVIDER=mock

# Target Bitcoin network: 'regtest', 'signet', or 'mainnet'
MACHINE_MONEY_NETWORK=regtest

# Automated settlement switch (true = pay without human signoff if under cap)
MACHINE_MONEY_AUTO_PAY_ENABLED=true

# Maximum satoshis permitted per single autonomous M2M transaction
MACHINE_MONEY_MAX_AUTOPAY_SATS=500

# Threshold at which policy requires explicit operator human-in-the-loop review
MACHINE_MONEY_AUTO_PAY_THRESHOLD_SATS=500

# Comma-separated list of approved service vendor provider IDs
MACHINE_MONEY_PROVIDER_ALLOWLIST=provider_pump_specialist,provider_bearing_inspections

# -----------------------------------------------------------------------------
# 2. LNbits Provider Adapter (Server-Side Only)
# -----------------------------------------------------------------------------
# Base URL for the LNbits instance (local or hosted)
LNBITS_BASE_URL=https://legend.lnbits.com

# Admin API key granting wallet payment execution permission (NEVER client-exposed)
LNBITS_ADMIN_KEY=your_lnbits_admin_key_here

# Invoice API key for generating payment requests (read-only capability)
LNBITS_INVOICE_KEY=your_lnbits_invoice_read_key_here

# -----------------------------------------------------------------------------
# 3. Core Lightning (CLN) / LND Node RPC (Optional Alternative Adapter)
# -----------------------------------------------------------------------------
CLN_RPC_URL=https://127.0.0.1:9735
CLN_RPC_USER=cln_rpc_user
CLN_RPC_PASSWORD=your_cln_rpc_password_here
CLN_MACAROON_PATH=~/.lightning/regtest/access.macaroon

# -----------------------------------------------------------------------------
# 4. Nostr Wallet Connect (NWC) & Agent Relays (Section 20 Stretch)
# -----------------------------------------------------------------------------
# NIP-47 Nostr Wallet Connect URI for non-custodial remote signer delegation
NWC_CONNECTION_STRING=nostr+walletconnect://pubkey_placeholder?relay=wss://relay.damus.io&secret=secret_placeholder

# NIP-90 telemetry event broadcast and service discovery relays
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.snort.social
